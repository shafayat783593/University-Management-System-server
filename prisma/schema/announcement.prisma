

model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  authorId    String   // User.id of the admin who posted it
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
  @@map("announcements")
}
