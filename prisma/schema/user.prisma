model User {
  id                 String       @id @default(uuid())
  name               String
  email              String       @unique
  password           String?
  googleId           String?      @unique
  authProvider       AuthProvider @default(CREDENTIAL)
  emailVerified      Boolean      @default(false)
  needPasswordChange Boolean      @default(false)
  role               Role         @default(STUDENT)
  status             UserStatus   @default(ACTIVE)
  imageUrl           String?
  imagePublicId      String?
  isDeleted          Boolean      @default(false)
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  studentProfile     StudentProfile?
  instructorProfile  InstructorProfile?

  @@map("users")
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  studentIdCode  String?  @unique // generated when admission is confirmed (e.g. CSE-27-0001); null until then
  admissionConfirmedAt DateTime? // set once the admission invoice is paid; gates enrollment
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  phone          String?
  address        String?
  dateOfBirth    DateTime?
  guardianName   String?
  guardianPhone  String?
  bloodGroup     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments           Enrollment[]
  attendanceRecords     AttendanceRecord[]
  results               Result[]
  invoices              FeeInvoice[]
  transactions          PaymentTransaction[]
  waivers               StudentWaiver[]
  admissionApplication  AdmissionApplication?

  @@index([departmentId])
  @@map("student_profiles")
}

model AdmissionApplication {
  id                  String   @id @default(uuid())
  studentId           String   @unique
  student             StudentProfile @relation(fields: [studentId], references: [id])
  status              ApplicationStatus @default(SUBMITTED)
  reviewedById        String?  // User.id of the admin who approved/rejected
  reviewedAt          DateTime?
  rejectionReason     String?
  previousInstitution String
  sscBoard            String?
  sscYear             Int?
  sscGpa              Float?
  hscBoard            String?
  hscYear             Int?
  hscGpa              Float?
  guardianOccupation  String?
  presentAddress      String?
  permanentAddress    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@map("admission_applications")
}

model InstructorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  departmentId       String
  department         Department @relation(fields: [departmentId], references: [id])
  qualification      String?
  resumeUrl          String?
  resumePublicId     String?
  verificationStatus InstructorApplicationStatus @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sections      Section[]
  coTeachingSections SectionInstructor[]

  @@index([departmentId])
  @@index([verificationStatus])
  @@map("instructor_profiles")
}
